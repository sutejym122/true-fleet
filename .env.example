# Copy this file to .env.local for local development, and set the same
# variables in your hosting provider for production.
#
# The contact and partner forms return an honest error until one of the
# options below is configured. See lib/enquiry-delivery.ts.

# Option 1: post every enquiry to a webhook (Zapier, Make, n8n, Slack, your own API)
# ENQUIRY_WEBHOOK_URL="https://"

# Option 2: email every enquiry through Resend
# RESEND_API_KEY="re_..."
# ENQUIRY_FROM_EMAIL="website@yourdomain.in"
# ENQUIRY_TO_EMAIL="enquiries@yourdomain.in"
